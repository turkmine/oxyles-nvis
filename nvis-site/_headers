# _headers — Cloudflare Workers / Pages.
# Файл обязан лежать в корне проекта (или в выходной директории сборки),
# поэтому он здесь, а не в deploy/.
#
# ВАЖНО: комментарии только через #. Конструкция /* ... */ здесь
# не поддерживается и ломает деплой ошибкой "Expected a colon-separated
# header pair".
#
# CSP именно здесь, а не в <meta http-equiv>: в meta не работает
# frame-ancestors, и браузер применяет meta-CSP к служебным запросам
# (robots.txt), из-за чего часть проверяющих инструментов его не читает.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; manifest-src 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=604800

# Установщик: имя содержит версию, поэтому можно кэшировать надолго.
/downloads/*
  Cache-Control: public, max-age=604800
  Content-Type: application/x-msi

/robots.txt
  Cache-Control: public, max-age=3600